# Номер телефона для пополнения баланса (Теле2)
PAYMENT_PHONE=+7-929-830-17-02

# USDT кошелёк (BEP-20 / Binance Smart Chain)
USDT_WALLET=0x97aa6013580c4f34fae3f7b4f42c176e9bd0ac7c

