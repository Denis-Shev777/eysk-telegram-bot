# Токен сообщества ВКонтакте
# Получить: vk.com/eysk_aparts → Управление → Настройки → Работа с API → Создать ключ доступа
VK_TOKEN=vk1.a.ВАШ_ТОКЕН_СООБЩЕСТВА

# Ваш личный VK user_id (числовой ID, не короткий адрес)
# Узнать: vk.com/id — число после /id в URL вашей страницы
ADMIN_VK_ID=123456789

